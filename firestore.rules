rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. التحقق الصارم من البريد الإلكتروني المعتمد للمدير (مع تجاهل حالة الأحرف)
    function isAdmin() {
      return request.auth != null && 
             request.auth.token.email.lower() in [
               'amohamedamr99@gmail.com',
               'admin@store.com'
             ];
    }

    // 2. مجموعة المنتجات (عطور، بخور، معطرات)
    match /perfumes/{perfumeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 3. إعدادات المتجر (الهاتف، رسوم الشحن، نص الواتساب)
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 4. طلبات الشراء (حماية مشددة لبيانات العملاء ومنع التلاعب)
    match /orders/{orderId} {
      // القراءة وقائمة الطلبات حصرياً للمدير الموثق
      allow read: if isAdmin();

      // شروط إنشاء الطلب للعميل:
      allow create: if 
        // حصر الحقول المسموح إرسالها فقط
        request.resource.data.keys().hasOnly([
          'customerName', 'customerPhone', 'customerAddress', 'city', 'notes',
          'items', 'subtotal', 'shippingCost', 'totalAmount', 'status', 'createdAt',
          // حقول التوافق مع الطلب الفردي السابق
          'productId', 'productNameEn', 'productNameAr', 'size', 'price'
        ])
        // إلزامية أن تكون الحالة المبدئية Pending فقط
        && request.resource.data.status in ['Pending', 'pending']
        // التحقق من صحة وحجم بيانات العميل
        && request.resource.data.customerName is string
        && request.resource.data.customerName.size() >= 2
        && request.resource.data.customerName.size() <= 100
        && request.resource.data.customerPhone is string
        && request.resource.data.customerPhone.size() >= 8
        && request.resource.data.customerPhone.size() <= 25
        && request.resource.data.customerAddress is string
        && request.resource.data.customerAddress.size() >= 3
        && request.resource.data.customerAddress.size() <= 300
        // في حال وجود قائمة عناصر للسلة
        && (!('items' in request.resource.data) || (
            request.resource.data.items is list &&
            request.resource.data.items.size() > 0 &&
            request.resource.data.items.size() <= 30
        ))
        // التحقق من أن المبالغ أرقام موجبة إن وجدت
        && (!('totalAmount' in request.resource.data) || (
            request.resource.data.totalAmount is number &&
            request.resource.data.totalAmount >= 0
        ));

      // تعديل حالة الطلب وحذفه حصرياً للأدمن
      allow update, delete: if isAdmin();
    }

    // إغلاق أي مسارات أو مجموعات أخرى غير مصرح بها
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
